	issn = {0002-8282},
	journal = {American Economic Review},
	keywords = {Cycles; Monetary Policy; Fiscal Policy,General Aggregative Models: Keynes,Keynesian,Post-Keynesian; Macroeconomics: Production; Business Fluctuations},
	langid = {english},
